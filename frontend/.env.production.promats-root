# Promats PROD deploy — https://promats.com.tr (kök domain, basePath YOK)
# Test/subpath build /var/www/paspas/frontend altında ayrı kalir (panel.avrasyaotomotiv.net/promats,
# .env.production kullanır). Bu dosya deploy-promats-web-root.sh tarafından build oncesi
# .env.production olarak kopyalanir — dogrudan .env.production'a yazilmiyor cunku o dosya
# subpath test build'i icin git'te takip ediliyor ve `git reset --hard` her deploy'da onu ezerdi.

# Client + SSR API (nginx /api/ -> paspas_api 8078, merge sonrasi ayni backend)
NEXT_PUBLIC_API_URL=https://promats.com.tr/api/web/promats

NEXT_PUBLIC_SITE_URL=https://promats.com.tr
NEXT_PUBLIC_APP_URL=https://promats.com.tr
NEXT_PUBLIC_MANIFEST_START_URL=/tr

# DevNote ("yazilimci notu") widget'i — subpath test build'inde hostname kontroluyle sadece
# panel.avrasyaotomotiv.net'te aktifti. Kok domain build'i sadece promats.com.tr/www'yi
# serve ettigi icin build-time flag ile kosulsuz acmak yeterli ve guvenli.
NEXT_PUBLIC_DEV_NOTES=1

# Server-only (build/SSR sirasinda kendi domain'ine HTTPS ile self-fetch yapmasin diye)
# NEXT_PUBLIC_ degil -> client bundle'a sizmaz, sadece Node tarafi kullanir.
API_BASE_URL=http://127.0.0.1:8078/api/web/promats
