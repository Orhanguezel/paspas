# Promats TEST deploy → https://panel.avrasyaotomotiv.net/promats
# Subpath build: PROMATS_BASE_PATH ile basePath aktif olur.
PROMATS_BASE_PATH=/promats
# Ham <a href> linkleri icin client-side basePath (next/link disi linkler)
NEXT_PUBLIC_BASE_PATH=/promats

# Client + SSR API (nginx /promats/api/ -> promats_api 8087)
NEXT_PUBLIC_API_URL=https://panel.avrasyaotomotiv.net/api/web/promats

NEXT_PUBLIC_SITE_URL=https://panel.avrasyaotomotiv.net/promats
NEXT_PUBLIC_APP_URL=https://panel.avrasyaotomotiv.net/promats
NEXT_PUBLIC_MANIFEST_START_URL=/promats/tr
